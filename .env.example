# ============================================================
# PDF & Notes Q&A Chatbot — environment configuration
# Copy to `.env` and fill in values. Backend loads it via
# pydantic-settings; the frontend only reads VITE_* variables.
# ============================================================

# ---------- Application ----------
APP_ENV=development
# CORS origins allowed by the API (comma-separated). In development the
# Vite dev server proxies /api to the backend, so browser origin cookies
# stay first-party; list the frontend origin anyway for direct API use.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Anonymous MVP identity. AUTH_MODE=anonymous issues a server-side session
# token cookie and treats it as the document owner. AUTH_MODE=authenticated
# requires a User row and is NOT implemented in the MVP (see docs/DECISIONS.md).
AUTH_MODE=anonymous

# ---------- Database (PostgreSQL + pgvector) ----------
# docker compose up -d db  ->  postgresql+psycopg://postgres:postgres@localhost:5432/pdf_qa
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pdf_qa

# ---------- Upload / processing limits ----------
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=300
# Upload endpoints receive files through the API process; processing runs in
# a background worker so large PDFs never block the request thread.

# ---------- Storage ----------
# LocalFileStorage root (private; never served statically).
STORAGE_DIR=storage
# Deletion policy for dependent chat data when a document is deleted:
# delete = remove sessions/messages/sources with the document.
# retain = keep conversation records (per docs/DECISIONS.md this is MVP default off).
DELETE_DEPENDENT_CHAT=delete

# ---------- Embedding provider (OpenAI-compatible) ----------
# Any OpenAI-compatible /embeddings endpoint works.
#
# Gemini (Google AI Studio key) — set BOTH provider blocks below to:
#   *_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   EMBEDDING_MODEL=text-embedding-004      -> EMBEDDING_DIM=768
#   EMBEDDING_MODEL=gemini-embedding-001    -> EMBEDDING_DIM=3072
#   LLM_MODEL=gemini-2.5-flash (or another Gemini chat model)
# EMBEDDING_DIM must match the model AND the database column: run migrations
# on a FRESH database after changing it (the migration runner reads it).
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
# Must match the dimension of EMBEDDING_MODEL and the DB vector column.
EMBEDDING_DIM=1536
# Optional `dimensions` request param (Gemini: 768 for gemini-embedding-001).
# When set it MUST equal EMBEDDING_DIM.
EMBEDDING_DIMENSIONS=
EMBEDDING_BATCH_SIZE=64

# ---------- LLM provider (OpenAI-compatible chat completions) ----------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1024

# ---------- RAG parameters ----------
# Chunks retrieved per question before the evidence gate.
RETRIEVAL_TOP_K=5
# Minimum cosine similarity for the best chunk to count as evidence.
# MODEL-DEPENDENT: OpenAI text-embedding-3-* family → ~0.25 works because
# unrelated texts score near 0. Gemini gemini-embedding-001 → ~0.48
# (measured: unrelated 0.42-0.47 vs on-topic 0.50+ once repeated page
# headers/footers are stripped at extraction time).
EVIDENCE_THRESHOLD=0.25
CHUNK_TARGET_TOKENS=450
CHUNK_OVERLAP_TOKENS=60

# ---------- Rate limiting (in-memory, per process — MVP scale) ----------
# requests per window, per bucket
RATE_LIMIT_UPLOAD_PER_MIN=10
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_STATUS_PER_MIN=120
RATE_LIMIT_WINDOW_SECONDS=60

# ---------- Frontend (Vite) ----------
# Base URL of the API as seen by the browser. Empty string means
# "same origin" — the Vite dev server proxies /api to the backend.
VITE_API_BASE_URL=

# ---------- Database pool tuning ----------
# Defaults (5/10, pre-ping on) suit real PostgreSQL. For the dev WASM
# database (devdb/server.mjs — single-user) use:
#   DB_POOL_SIZE=1, DB_MAX_OVERFLOW=0, DB_POOL_PRE_PING=false
#DB_POOL_SIZE=5
#DB_MAX_OVERFLOW=10
#DB_POOL_PRE_PING=true
